# Example development configuration; inspect available tags and targets before use.
# Stable, explicitly pinned Android 15 AOSP release tag for reproducibility.
AOSP_TAG=android-15.0.0_r36
AOSP_MANIFEST_URL=https://android.googlesource.com/platform/manifest
AOSP_DIR=aosp
# Official AOSP Cuttlefish virtual device lunch target.
AOSP_LUNCH=aosp_cf_x86_64_phone-trunk_staging-userdebug
BUILD_JOBS=16
